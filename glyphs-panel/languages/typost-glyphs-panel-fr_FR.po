#: glyphs-panel/glyphs-panel.php:214
msgid "Glyphs"
msgstr "Glyphes"

#: glyphs-panel/glyphs-panel.php:227
msgid "Glyph Browser"
msgstr "Navigateur de glyphes"

#: glyphs-panel/glyphs-panel.php:228
msgid "Explore every character and OpenType feature in your fonts. Click a glyph to copy it to the clipboard. To insert glyphs into content, use the Glyphs button inside the editor."
msgstr "Explorez tous les caractères et fonctionnalités OpenType de vos polices. Cliquez sur un glyphe pour le copier dans le presse-papiers. Pour insérer des glyphes dans le contenu, utilisez le bouton Glyphes dans l’éditeur."

#: glyphs-panel/glyphs-panel.php:231
msgid "Open Glyph Browser"
msgstr "Ouvrir le navigateur de glyphes"

#: glyphs-panel/glyphs-panel.php:234
msgid "Font data is read in your browser, on demand, for metadata only — no glyph outlines are ever extracted or stored."
msgstr "Les données de police sont lues dans votre navigateur, à la demande, pour les métadonnées uniquement — aucun contour de glyphe n’est jamais extrait ni stocké."

#: glyphs-panel/glyphs-panel.php:281
msgid "Typography Stylist - Glyphs Panel requires the Typography Stylist plugin to be installed and activated."
msgstr "Typography Stylist - Glyphs Panel nécessite que l’extension Typography Stylist soit installée et activée."

#: glyphs-panel/assets/js/editor.js:128
msgid "Glyphs…"
msgstr "Glyphes…"

#: glyphs-panel/assets/js/glyphs-modal.js:170
msgid "No readable font file is available for this font source. Glyph browsing works best with uploaded webfont kits."
msgstr "Aucun fichier de police lisible n’est disponible pour cette source. La navigation de glyphes fonctionne mieux avec les kits de polices web téléversés."

#: glyphs-panel/assets/js/glyphs-modal.js:171
msgid "The font file could not be fetched (cross-origin restriction). Glyph browsing is unavailable for this font."
msgstr "Le fichier de police n’a pas pu être récupéré (restriction cross-origin). La navigation de glyphes est indisponible pour cette police."

#: glyphs-panel/assets/js/glyphs-modal.js:172
msgid "The font file could not be downloaded. Please try again."
msgstr "Le fichier de police n’a pas pu être téléchargé. Veuillez réessayer."

#: glyphs-panel/assets/js/glyphs-modal.js:173
msgid "This font kit only contains formats that cannot be read for glyph browsing (e.g. EOT)."
msgstr "Ce kit de polices ne contient que des formats illisibles pour la navigation de glyphes (ex. EOT)."

#: glyphs-panel/assets/js/glyphs-modal.js:174
msgid "The font file could not be read. It may be malformed or use unsupported features."
msgstr "Le fichier de police n’a pas pu être lu. Il est peut-être mal formé ou utilise des fonctionnalités non prises en charge."

#: glyphs-panel/assets/js/glyphs-modal.js:189
msgid "The font-parsing libraries bundled with the plugin could not be loaded. This is an installation problem, not a problem with the font — the plugin's vendor files may be missing. Try reinstalling the plugin."
msgstr "Les bibliothèques d’analyse de polices fournies avec l’extension n’ont pas pu être chargées. Il s’agit d’un problème d’installation, pas d’un problème de police — les fichiers « vendor » de l’extension sont peut-être manquants. Essayez de réinstaller l’extension."

#: glyphs-panel/assets/js/glyphs-modal.js:190
msgid "The font file could not be decompressed. The file may be damaged."
msgstr "Le fichier de police n’a pas pu être décompressé. Le fichier est peut-être endommagé."

#. translators: %s: comma-separated file paths
#: glyphs-panel/assets/js/glyphs-modal.js:299
#, javascript-format
msgid "Missing files: %s"
msgstr "Fichiers manquants : %s"

#: glyphs-panel/assets/js/glyphs-modal.js:672
msgid "Try again"
msgstr "Réessayer"

#: glyphs-panel/glyphs-panel.php:277
msgid "The Glyph Browser cannot work on this installation: the bundled font-parsing libraries are missing. Reinstall the plugin to restore them."
msgstr "Le navigateur de glyphes ne peut pas fonctionner sur cette installation : les bibliothèques d’analyse de polices fournies sont manquantes. Réinstallez l’extension pour les restaurer."

#: glyphs-panel/assets/js/glyphs-modal.js:106
msgid "WP Font Library"
msgstr "Bibliothèque de polices WP"

#: glyphs-panel/assets/js/glyphs-modal.js:432
msgid "Font"
msgstr "Police"

#: glyphs-panel/assets/js/glyphs-modal.js:444
msgid "No fonts are configured in Typography Stylist. Upload a webfont kit to browse glyphs."
msgstr "Aucune police n’est configurée dans Typography Stylist. Téléversez un kit de polices web pour parcourir les glyphes."

#: glyphs-panel/assets/js/glyphs-modal.js:446
msgid "Reading font data…"
msgstr "Lecture des données de police…"

#: glyphs-panel/assets/js/glyphs-modal.js:450
msgid "Adobe Fonts serves dynamically subset files — this glyph list may be incomplete."
msgstr "Adobe Fonts sert des fichiers partiels dynamiques — cette liste de glyphes peut être incomplète."

#: glyphs-panel/assets/js/glyphs-modal.js:462
msgid "Search"
msgstr "Rechercher"

#: glyphs-panel/assets/js/glyphs-modal.js:408
msgid "Search: character, U+0041, or glyph name"
msgstr "Rechercher : caractère, U+0041 ou nom de glyphe"

#: glyphs-panel/assets/js/glyphs-modal.js:409
msgid "Search: character or U+0041"
msgstr "Rechercher : caractère ou U+0041"

#: glyphs-panel/assets/js/glyphs-modal.js:470
msgid "Unicode block"
msgstr "Bloc Unicode"

#: glyphs-panel/assets/js/glyphs-modal.js:391
#, javascript-format
msgid "All blocks (%d)"
msgstr "Tous les blocs (%d)"

#: glyphs-panel/assets/js/glyphs-modal.js:399
msgid "Other"
msgstr "Autre"

#: glyphs-panel/assets/js/glyphs-modal.js:478
msgid "OpenType feature"
msgstr "Fonctionnalité OpenType"

#: glyphs-panel/assets/js/glyphs-modal.js:376
msgid "All glyphs"
msgstr "Tous les glyphes"

#: glyphs-panel/assets/js/glyphs-modal.js:495
msgid "Alternates for character"
msgstr "Alternatives pour le caractère"

#: glyphs-panel/assets/js/glyphs-modal.js:497
msgid "Alternates for…"
msgstr "Alternatives pour…"

#: glyphs-panel/assets/js/glyphs-modal.js:511
#, javascript-format
msgid "Use \"%s\""
msgstr "Utiliser « %s »"

#: glyphs-panel/assets/js/glyphs-modal.js:280
msgid "ligature"
msgstr "ligature"

#: glyphs-panel/assets/js/glyphs-modal.js:289
#, javascript-format
msgid "#%1$d of %2$d"
msgstr "n°%1$d sur %2$d"

#: glyphs-panel/assets/js/glyphs-modal.js:293
msgid "base glyph"
msgstr "glyphe de base"

#: glyphs-panel/assets/js/glyphs-modal.js:306
#, javascript-format
msgid "Copied \"%s\" to clipboard"
msgstr "« %s » copié dans le presse-papiers"

#: glyphs-panel/assets/js/glyphs-modal.js:310
msgid "Could not copy to clipboard."
msgstr "Impossible de copier dans le presse-papiers."

#: glyphs-panel/assets/js/glyphs-modal.js:338
#, javascript-format
msgid "Inserted \"%1$s\" (%2$s)"
msgstr "« %1$s » inséré (%2$s)"

#: glyphs-panel/assets/js/glyphs-modal.js:339
#, javascript-format
msgid "Inserted \"%s\""
msgstr "« %s » inséré"

#: glyphs-panel/assets/js/glyphs-modal.js:556
msgid "This character is not available in the selected font."
msgstr "Ce caractère n’est pas disponible dans la police sélectionnée."

#: glyphs-panel/assets/js/glyphs-modal.js:557
msgid "No glyphs match the current search and filters."
msgstr "Aucun glyphe ne correspond à la recherche et aux filtres actuels."

#: glyphs-panel/assets/js/glyphs-modal.js:582
msgid "Hover a glyph for details. Click to insert."
msgstr "Survolez un glyphe pour les détails. Cliquez pour insérer."

#: glyphs-panel/assets/js/glyphs-modal.js:589
msgid "Re-read font"
msgstr "Relire la police"

#: glyphs-panel/assets/js/glyphs-modal.js:591
#, javascript-format
msgid "%d contextual substitution rules are not browsable."
msgstr "%d règles de substitution contextuelle ne sont pas consultables."

#: glyphs-panel/assets/js/glyphs-modal.js:593
#, javascript-format
msgid "%d glyphs"
msgstr "%d glyphes"

#: glyphs-panel/assets/js/glyphs-modal.js:577
#, javascript-format
msgid "%d alternates"
msgstr "%d alternatives"

#: glyphs-panel/assets/js/glyphs-modal.js:415
msgid "Browse only — click a glyph to copy it"
msgstr "Consultation seule — cliquez sur un glyphe pour le copier"

#: glyphs-panel/assets/js/glyphs-modal.js:417
#, javascript-format
msgid "Replaces selection: \"%s\""
msgstr "Remplace la sélection : « %s »"

#: glyphs-panel/assets/js/glyphs-modal.js:419
msgid "Inserts at cursor"
msgstr "Insère au curseur"
