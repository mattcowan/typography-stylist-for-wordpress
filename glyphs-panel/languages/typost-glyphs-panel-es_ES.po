#: assets/js/glyphs-modal.js:870
msgid "Search: character, U+0041, or glyph name"
msgstr "Buscar: carácter, U+0041 o nombre de glifo"

#: assets/js/glyphs-modal.js:871
msgid "Search: character or U+0041"
msgstr "Buscar: carácter o U+0041"

#: assets/js/glyphs-modal.js:875
msgid "Browse only: click a glyph to copy it"
msgstr "Solo consulta: haz clic en un glifo para copiarlo"

#. translators: %s: selected text
#: assets/js/glyphs-modal.js:877
#, js-format
msgid "Replaces selection: “%s”"
msgstr "Reemplaza la selección: «%s»"

#: assets/js/glyphs-modal.js:879
msgid "Inserts at cursor"
msgstr "Inserta en el cursor"

#: assets/js/glyphs-modal.js:917
msgid "Convert to Typography Stylist Block"
msgstr "Convertir en bloque de Typography Stylist"

#: assets/js/glyphs-modal.js:925
msgid "Manage accessibility settings"
msgstr "Gestionar los ajustes de accesibilidad"

#: assets/js/glyphs-modal.js:932
msgid "Font"
msgstr "Fuente"

#: assets/js/glyphs-modal.js:946
msgid "No fonts are configured in Typography Stylist. Upload a webfont kit to browse glyphs."
msgstr "No hay fuentes configuradas en Typography Stylist. Sube un kit de fuentes web para explorar glifos."

#: assets/js/glyphs-modal.js:948
msgid "Reading font data…"
msgstr "Leyendo datos de la fuente…"

#: assets/js/glyphs-modal.js:953
msgid "Try again"
msgstr "Reintentar"

#: assets/js/glyphs-modal.js:961
msgid "Adobe Fonts serves dynamically subset files, so this glyph list may be incomplete."
msgstr "Adobe Fonts sirve archivos parciales dinámicos, así que esta lista de glifos puede estar incompleta."

#: assets/js/glyphs-modal.js:974
msgid "Alternates for character"
msgstr "Alternativas para el carácter"

#: assets/js/glyphs-modal.js:977
msgid "Alternates for…"
msgstr "Alternativas para…"

#. translators: %s: character(s)
#: assets/js/glyphs-modal.js:997
#, js-format
msgid "Use “%s”"
msgstr "Usar «%s»"

#: assets/js/glyphs-modal.js:1008
msgid "Search"
msgstr "Buscar"

#: assets/js/glyphs-modal.js:1018
msgid "OpenType feature"
msgstr "Característica OpenType"

#: assets/js/glyphs-modal.js:1035
msgid "Unicode block"
msgstr "Bloque Unicode"

#. translators: %s: the characters typed
#: assets/js/glyphs-modal.js:1110
#, js-format
msgid "This font has no ligature for “%s”. Type one character to browse its alternates."
msgstr "Esta fuente no tiene ligadura para «%s». Escribe un solo carácter para explorar sus alternativas."

#: assets/js/glyphs-modal.js:1112
msgid "This character is not available in the selected font."
msgstr "Este carácter no está disponible en la fuente seleccionada."

#: assets/js/glyphs-modal.js:1113
msgid "No glyphs match the current search and filters."
msgstr "Ningún glifo coincide con la búsqueda y los filtros actuales."

#. translators: %d: number of alternates
#: assets/js/glyphs-modal.js:1134
#, js-format
msgid "%d alternate"
msgid_plural "%d alternates"
msgstr[0] "%d alternativa"
msgstr[1] "%d alternativas"

#: assets/js/glyphs-modal.js:1137
msgid "Hover over a glyph, or move to it with the arrow keys, to see its details."
msgstr "Pasa el cursor sobre un glifo, o llega a él con las teclas de flecha, para ver sus detalles."

#: assets/js/glyphs-modal.js:1145
msgid "Re-read font"
msgstr "Releer la fuente"

#. translators: %d: number of skipped lookups
#: assets/js/glyphs-modal.js:1147
#, js-format
msgid "%d contextual substitution rule is not browsable."
msgid_plural "%d contextual substitution rules are not browsable."
msgstr[0] "%d regla de sustitución contextual no se puede explorar."
msgstr[1] "%d reglas de sustitución contextual no se pueden explorar."
