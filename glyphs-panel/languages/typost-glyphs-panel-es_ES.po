#: glyphs-panel/glyphs-panel.php:214
msgid "Glyphs"
msgstr "Glifos"

#: glyphs-panel/glyphs-panel.php:227
msgid "Glyph Browser"
msgstr "Explorador de glifos"

#: glyphs-panel/glyphs-panel.php:228
msgid "Explore every character and OpenType feature in your fonts. Click a glyph to copy it to the clipboard. To insert glyphs into content, use the Glyphs button inside the editor."
msgstr "Explora todos los caracteres y características OpenType de tus fuentes. Haz clic en un glifo para copiarlo al portapapeles. Para insertar glifos en el contenido, usa el botón Glifos dentro del editor."

#: glyphs-panel/glyphs-panel.php:231
msgid "Open Glyph Browser"
msgstr "Abrir el explorador de glifos"

#: glyphs-panel/glyphs-panel.php:234
msgid "Font data is read in your browser, on demand, for metadata only — no glyph outlines are ever extracted or stored."
msgstr "Los datos de la fuente se leen en tu navegador, bajo demanda, solo para metadatos — nunca se extraen ni almacenan contornos de glifos."

#: glyphs-panel/glyphs-panel.php:281
msgid "Typography Stylist - Glyphs Panel requires the Typography Stylist plugin to be installed and activated."
msgstr "Typography Stylist - Glyphs Panel requiere que el plugin Typography Stylist esté instalado y activado."

#: glyphs-panel/assets/js/editor.js:128
msgid "Glyphs…"
msgstr "Glifos…"

#: glyphs-panel/assets/js/glyphs-modal.js:170
msgid "No readable font file is available for this font source. Glyph browsing works best with uploaded webfont kits."
msgstr "No hay un archivo de fuente legible para este origen. La exploración de glifos funciona mejor con kits de fuentes web subidos."

#: glyphs-panel/assets/js/glyphs-modal.js:171
msgid "The font file could not be fetched (cross-origin restriction). Glyph browsing is unavailable for this font."
msgstr "No se pudo obtener el archivo de fuente (restricción cross-origin). La exploración de glifos no está disponible para esta fuente."

#: glyphs-panel/assets/js/glyphs-modal.js:172
msgid "The font file could not be downloaded. Please try again."
msgstr "No se pudo descargar el archivo de fuente. Inténtalo de nuevo."

#: glyphs-panel/assets/js/glyphs-modal.js:173
msgid "This font kit only contains formats that cannot be read for glyph browsing (e.g. EOT)."
msgstr "Este kit de fuentes solo contiene formatos que no se pueden leer para la exploración de glifos (p. ej. EOT)."

#: glyphs-panel/assets/js/glyphs-modal.js:174
msgid "The font file could not be read. It may be malformed or use unsupported features."
msgstr "No se pudo leer el archivo de fuente. Puede estar dañado o usar características no compatibles."

#: glyphs-panel/assets/js/glyphs-modal.js:106
msgid "WP Font Library"
msgstr "Biblioteca de fuentes de WP"

#: glyphs-panel/assets/js/glyphs-modal.js:432
msgid "Font"
msgstr "Fuente"

#: glyphs-panel/assets/js/glyphs-modal.js:444
msgid "No fonts are configured in Typography Stylist. Upload a webfont kit to browse glyphs."
msgstr "No hay fuentes configuradas en Typography Stylist. Sube un kit de fuentes web para explorar glifos."

#: glyphs-panel/assets/js/glyphs-modal.js:446
msgid "Reading font data…"
msgstr "Leyendo datos de la fuente…"

#: glyphs-panel/assets/js/glyphs-modal.js:450
msgid "Adobe Fonts serves dynamically subset files — this glyph list may be incomplete."
msgstr "Adobe Fonts sirve archivos parciales dinámicos — esta lista de glifos puede estar incompleta."

#: glyphs-panel/assets/js/glyphs-modal.js:462
msgid "Search"
msgstr "Buscar"

#: glyphs-panel/assets/js/glyphs-modal.js:408
msgid "Search: character, U+0041, or glyph name"
msgstr "Buscar: carácter, U+0041 o nombre de glifo"

#: glyphs-panel/assets/js/glyphs-modal.js:409
msgid "Search: character or U+0041"
msgstr "Buscar: carácter o U+0041"

#: glyphs-panel/assets/js/glyphs-modal.js:470
msgid "Unicode block"
msgstr "Bloque Unicode"

#: glyphs-panel/assets/js/glyphs-modal.js:391
#, javascript-format
msgid "All blocks (%d)"
msgstr "Todos los bloques (%d)"

#: glyphs-panel/assets/js/glyphs-modal.js:399
msgid "Other"
msgstr "Otro"

#: glyphs-panel/assets/js/glyphs-modal.js:478
msgid "OpenType feature"
msgstr "Característica OpenType"

#: glyphs-panel/assets/js/glyphs-modal.js:376
msgid "All glyphs"
msgstr "Todos los glifos"

#: glyphs-panel/assets/js/glyphs-modal.js:495
msgid "Alternates for character"
msgstr "Alternativas para el carácter"

#: glyphs-panel/assets/js/glyphs-modal.js:497
msgid "Alternates for…"
msgstr "Alternativas para…"

#: glyphs-panel/assets/js/glyphs-modal.js:511
#, javascript-format
msgid "Use \"%s\""
msgstr "Usar «%s»"

#: glyphs-panel/assets/js/glyphs-modal.js:280
msgid "ligature"
msgstr "ligadura"

#: glyphs-panel/assets/js/glyphs-modal.js:289
#, javascript-format
msgid "#%1$d of %2$d"
msgstr "n.º %1$d de %2$d"

#: glyphs-panel/assets/js/glyphs-modal.js:293
msgid "base glyph"
msgstr "glifo base"

#: glyphs-panel/assets/js/glyphs-modal.js:306
#, javascript-format
msgid "Copied \"%s\" to clipboard"
msgstr "«%s» copiado al portapapeles"

#: glyphs-panel/assets/js/glyphs-modal.js:310
msgid "Could not copy to clipboard."
msgstr "No se pudo copiar al portapapeles."

#: glyphs-panel/assets/js/glyphs-modal.js:338
#, javascript-format
msgid "Inserted \"%1$s\" (%2$s)"
msgstr "«%1$s» insertado (%2$s)"

#: glyphs-panel/assets/js/glyphs-modal.js:339
#, javascript-format
msgid "Inserted \"%s\""
msgstr "«%s» insertado"

#: glyphs-panel/assets/js/glyphs-modal.js:556
msgid "This character is not available in the selected font."
msgstr "Este carácter no está disponible en la fuente seleccionada."

#: glyphs-panel/assets/js/glyphs-modal.js:557
msgid "No glyphs match the current search and filters."
msgstr "Ningún glifo coincide con la búsqueda y los filtros actuales."

#: glyphs-panel/assets/js/glyphs-modal.js:582
msgid "Hover a glyph for details. Click to insert."
msgstr "Pasa el cursor sobre un glifo para ver detalles. Haz clic para insertar."

#: glyphs-panel/assets/js/glyphs-modal.js:589
msgid "Re-read font"
msgstr "Releer la fuente"

#: glyphs-panel/assets/js/glyphs-modal.js:591
#, javascript-format
msgid "%d contextual substitution rules are not browsable."
msgstr "%d reglas de sustitución contextual no se pueden explorar."

#: glyphs-panel/assets/js/glyphs-modal.js:593
#, javascript-format
msgid "%d glyphs"
msgstr "%d glifos"

#: glyphs-panel/assets/js/glyphs-modal.js:577
#, javascript-format
msgid "%d alternates"
msgstr "%d alternativas"

#: glyphs-panel/assets/js/glyphs-modal.js:415
msgid "Browse only — click a glyph to copy it"
msgstr "Solo consulta — haz clic en un glifo para copiarlo"

#: glyphs-panel/assets/js/glyphs-modal.js:417
#, javascript-format
msgid "Replaces selection: \"%s\""
msgstr "Reemplaza la selección: «%s»"

#: glyphs-panel/assets/js/glyphs-modal.js:419
msgid "Inserts at cursor"
msgstr "Inserta en el cursor"
