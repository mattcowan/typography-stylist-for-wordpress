#, php-format
msgid "Variable font (axes: %s)"
msgstr "Fuente variable (ejes: %s)"

#: variable-fonts.php:347
msgid "Configured as a variable font"
msgstr "Configurada como fuente variable"

#: variable-fonts.php:352
msgid "Variable"
msgstr "Variable"

#: variable-fonts.php:384
msgid "Variable Font"
msgstr "Fuente variable"

#: variable-fonts.php:386
msgid "Enable to define variable font axes (weight, width, slant, etc.) with custom ranges."
msgstr "Activa para definir ejes de fuente variable (peso, anchura, inclinación, etc.) con rangos personalizados."

#: variable-fonts.php:394
#: assets/js/admin.js:24
msgid "Tag"
msgstr "Etiqueta"

#: variable-fonts.php:394
#: assets/js/admin.js:24
msgid "Axis tag"
msgstr "Etiqueta del eje"

#: variable-fonts.php:395
#: assets/js/admin.js:25
msgid "Name"
msgstr "Nombre"

#: variable-fonts.php:395
#: assets/js/admin.js:25
msgid "Axis name"
msgstr "Nombre del eje"

#: variable-fonts.php:396
#: assets/js/admin.js:26
msgid "Min"
msgstr "Mín"

#: variable-fonts.php:399
#: assets/js/admin.js:29
msgid "Max"
msgstr "Máx"

#: variable-fonts.php:402
#: assets/js/admin.js:32
msgid "Default"
msgstr "Predeterminado"

#: variable-fonts.php:405
#: assets/js/admin.js:35
msgid "Remove axis"
msgstr "Eliminar eje"

#: variable-fonts.php:411
msgid "+ Add Axis"
msgstr "+ Añadir eje"

#: variable-fonts.php:423
msgid "Detect Axes from Font File"
msgstr "Detectar ejes desde el archivo de fuente"

#: variable-fonts.php:427
msgid "Reads the axes from the font file and replaces all the axis rows above. Axis names, ranges, and defaults that you set by hand are lost. Nothing is saved until you click “Save Changes”."
msgstr "Lee los ejes del archivo de fuente y reemplaza todas las filas de ejes de arriba. Se pierden los nombres, rangos y valores predeterminados de los ejes que hayas ajustado a mano. No se guarda nada hasta que hagas clic en «Guardar cambios»."

#: variable-fonts.php:438
msgid "Hide weight selection"
msgstr "Ocultar la selección de peso"

#: variable-fonts.php:440
msgid "Hide the standard weight checkboxes above. This is on by default for a variable font."
msgstr "Oculta las casillas de peso estándar de arriba. Esta opción está activada por defecto para una fuente variable."

#: variable-fonts.php:633
msgid "Axes can only be re-detected from uploaded font files."
msgstr "Los ejes solo se pueden volver a detectar desde archivos de fuente subidos."

#: variable-fonts.php:660
msgid "Axes array is required"
msgstr "Se requiere el array de ejes"

#: variable-fonts.php:794
msgid "Settings saved successfully!"
msgstr "¡Ajustes guardados!"

#: assets/js/admin.js:200
msgid "No variable axes found in the resolved font file (no fvar table)."
msgstr "No se encontraron ejes variables en el archivo de fuente resuelto (sin tabla fvar)."

#: assets/js/admin.js:201
msgid "Font data not found on this page."
msgstr "No se encontraron datos de la fuente en esta página."

#: assets/js/admin.js:202
msgid "No font file could be found for this font."
msgstr "No se pudo encontrar ningún archivo para esta fuente."

#: assets/js/admin.js:203
msgid "The font file download was blocked by the remote server (CORS)."
msgstr "La descarga del archivo de fuente fue bloqueada por el servidor remoto (CORS)."

#: assets/js/admin.js:204
msgid "The font file could not be downloaded."
msgstr "No se pudo descargar el archivo de fuente."

#: assets/js/admin.js:205
msgid "The font file format is not supported."
msgstr "El formato del archivo de fuente no es compatible."

#: assets/js/admin.js:206
msgid "The font-parsing libraries could not be loaded."
msgstr "No se pudieron cargar las bibliotecas de análisis de fuentes."

#: assets/js/admin.js:207
#: assets/js/admin.js:208
msgid "The font file could not be read."
msgstr "No se pudo leer el archivo de fuente."

#: assets/js/admin.js:445
msgid "Re-detecting reads the axes back out of the font file and replaces every axis row for this font, discarding any values you set by hand. Continue?"
msgstr "Volver a detectar lee los ejes del archivo de fuente y reemplaza todas las filas de ejes de esta fuente, descartando los valores que hayas ajustado a mano. ¿Continuar?"

#: assets/js/admin.js:456
msgid "Detecting axes…"
msgstr "Detectando ejes…"

#. translators: %d: number of detected variable font axes.
#: assets/js/admin.js:486
#, js-format
msgid "Detected %d axis and replaced the rows above. Review it, then click “Save Changes” to store it."
msgid_plural "Detected %d axes and replaced the rows above. Review them, then click “Save Changes” to store them."
msgstr[0] "Se detectó %d eje y se reemplazaron las filas de arriba. Revísalo y luego haz clic en «Guardar cambios» para almacenarlo."
msgstr[1] "Se detectaron %d ejes y se reemplazaron las filas de arriba. Revísalos y luego haz clic en «Guardar cambios» para almacenarlos."

#. translators: 1: number of variable fonts detected, 2: total number of new fonts.
#: assets/js/admin.js:611
#, js-format
msgid "Variable font axes detected and saved for %1$d of %2$d new fonts."
msgstr "Se detectaron y guardaron ejes de fuente variable para %1$d de %2$d fuentes nuevas."

#: assets/js/editor.js:318
msgid "Reset to defaults"
msgstr "Restablecer valores predeterminados"

