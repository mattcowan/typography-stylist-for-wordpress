msgid "Remove axis"
msgstr "Supprimer l'axe"

#: variable-fonts.php:412
msgid "+ Add Axis"
msgstr "+ Ajouter un axe"

#: variable-fonts.php:427
msgid "Hide weight selection"
msgstr "Masquer la sélection de graisse"

#: variable-fonts.php:429
msgid "Hide the standard weight checkboxes above. Auto-enabled when no wght axis is defined."
msgstr "Masque les cases de graisse standard ci-dessus. Activé automatiquement quand aucun axe wght n'est défini."

#: variable-fonts.php:599
msgid "Axes array is required"
msgstr "Le tableau d'axes est requis"

#: variable-fonts.php:733
msgid "Settings saved successfully! Reloading page..."
msgstr "Réglages enregistrés ! Rechargement de la page…"

#: assets/js/editor.js
msgid "Variable Font Axes"
msgstr "Axes de police variable"

#: assets/js/editor.js
msgid "Reset to defaults"
msgstr "Réinitialiser aux valeurs par défaut"

#: variable-fonts.php:424
msgid "Detect Axes from Font File"
msgstr "Détecter les axes depuis le fichier de police"

#: variable-fonts.php:428
msgid "Reads the axes back out of the font file and replaces every axis row above — any axis names, ranges, or defaults you set by hand are discarded. Nothing is stored until you save."
msgstr "Relit les axes depuis le fichier de police et remplace toutes les lignes d'axes ci-dessus — les noms, plages ou valeurs par défaut que vous avez saisis à la main sont supprimés. Rien n'est enregistré tant que vous n'avez pas sauvegardé."

#: variable-fonts.php:634
msgid "Axes can only be re-detected from uploaded font files."
msgstr "Les axes ne peuvent être redétectés qu'à partir de fichiers de police téléversés."

#: assets/js/admin.js
msgid "Detecting axes…"
msgstr "Détection des axes…"

#: assets/js/admin.js
msgid "Re-detecting reads the axes back out of the font file and replaces every axis row for this font, discarding any values you set by hand. Continue?"
msgstr "La redétection relit les axes depuis le fichier de police et remplace toutes les lignes d'axes de cette police, en supprimant les valeurs que vous avez saisies à la main. Continuer ?"

#. translators: %d: number of detected variable font axes.
#: assets/js/admin.js
#, javascript-format
msgid "Detected %d axes, replacing the rows above. Review them, then Save Changes to store them."
msgstr "%d axes détectés, remplaçant les lignes ci-dessus. Vérifiez-les, puis cliquez sur Enregistrer les modifications pour les sauvegarder."

#: assets/js/admin.js
msgid "No variable axes found in the resolved font file (no fvar table)."
msgstr "Aucun axe variable trouvé dans le fichier de police résolu (pas de table fvar)."

#: assets/js/admin.js
msgid "Font data not found on this page."
msgstr "Données de police introuvables sur cette page."

#: assets/js/admin.js
msgid "No font file could be found for this font."
msgstr "Aucun fichier de police n'a pu être trouvé pour cette police."

#: assets/js/admin.js
msgid "The font file download was blocked by the remote server (CORS)."
msgstr "Le téléchargement du fichier de police a été bloqué par le serveur distant (CORS)."

#: assets/js/admin.js
msgid "The font file could not be downloaded."
msgstr "Le fichier de police n'a pas pu être téléchargé."

#: assets/js/admin.js
msgid "The font file format is not supported."
msgstr "Le format du fichier de police n'est pas pris en charge."

#: assets/js/admin.js
msgid "The font-parsing libraries could not be loaded."
msgstr "Les bibliothèques d'analyse de polices n'ont pas pu être chargées."

#: assets/js/admin.js
msgid "The font file could not be read."
msgstr "Le fichier de police n'a pas pu être lu."

#: assets/js/admin.js
#, javascript-format
msgid "Variable font axes detected and saved for %1$d of %2$d new fonts."
msgstr "Axes de police variable détectés et enregistrés pour %1$d des %2$d nouvelles polices."

