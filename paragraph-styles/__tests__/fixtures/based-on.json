		},
		{
			"label": "a first parent: what the parent sets and the look does not is stored empty, so the look stays",
			"full": { "fontId": 36, "fontSize": "18", "lineHeight": 1.2 },
			"parent": { "fontId": 37, "fontWeight": "400", "fontStyle": "italic", "fontSize": "20", "lineHeight": 1.5, "features": ["liga"] },
			"expected": { "fontSize": "18", "fontId": 36, "lineHeight": 1.2, "fontWeight": "", "fontStyle": "", "features": [] }
		},
		{
			"label": "a look with no size or case against a parent with both stores inherit and Default",
			"full": { "fontId": 5 },
			"parent": { "fontId": 5, "fontSize": "20", "textCase": "uppercase" },
			"expected": { "fontSize": "inherit", "textCase": "" }
		},
		{
			"label": "a changed size sends the whole size group",
			"full": { "fontSize": "responsive", "fontSizeUnit": "rem", "fontSizeMin": 16, "fontSizePreferred": 18, "fontSizeMax": 24 },
			"parent": { "fontSize": "responsive", "fontSizeUnit": "rem", "fontSizeMin": 16, "fontSizePreferred": 18, "fontSizeMax": 20 },
			"expected": { "fontSize": "responsive", "fontSizeUnit": "rem", "fontSizeMin": 16, "fontSizePreferred": 18, "fontSizeMax": 24 }
		},
		{
			"label": "small caps without fake small caps differ from small caps with them",
			"full": { "textCase": "small-caps", "fakeSmallCaps": false },
			"parent": { "textCase": "small-caps" },
			"expected": { "textCase": "small-caps", "fakeSmallCaps": false }
		},
		{
			"label": "alignment (#207): what the parent sets and the look does not is stored empty",
			"full": { "fontId": 5 },
			"parent": { "fontId": 5, "alignment": "justify", "alignLast": "center", "wordSpacing": 50, "textWrap": "balance" },
			"expected": { "alignment": "", "wordSpacing": 0, "textWrap": "" }
		},
		{
			"label": "alignment (#207): the same alignment with another last line is the whole group",
			"full": { "alignment": "justify", "alignLast": "end", "textWrap": "balance" },
			"parent": { "alignment": "justify", "alignLast": "center", "textWrap": "balance" },
			"expected": { "alignment": "justify", "alignLast": "end" }
		}
	]
}
