msgstr "Saisissez un nom pour le style."

#: assets/js/admin.js:496
msgid "Enter a size greater than 0."
msgstr "Saisissez une taille supérieure à 0."

#: assets/js/admin.js:503
msgid "Enter all three sizes, each greater than 0."
msgstr "Saisissez les trois tailles, chacune supérieure à 0."

#: assets/js/admin.js:512
