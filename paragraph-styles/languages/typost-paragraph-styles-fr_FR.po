msgstr "Esperluette (&)"

#: includes/class-typost-ps-grep.php:126
msgid "Custom pattern"
msgstr "Motif personnalisé"

#: includes/class-typost-ps-grep.php:170
#: assets/js/admin.js:1282
msgid "Enter a pattern."
msgstr "Saisissez un motif."

#: includes/class-typost-ps-grep.php:173
msgid "The pattern is not valid UTF-8 text."
msgstr "Le motif n’est pas un texte UTF-8 valide."

#: includes/class-typost-ps-grep.php:178
#: assets/js/admin.js:1286
#, php-format
msgid "The pattern is too long. Use %d characters or fewer."
msgstr "Le motif est trop long. Utilisez %d caractères au maximum."

#: includes/class-typost-ps-grep.php:181
msgid "The pattern contains a control character, such as a tab or a line break. Use \\t or \\n instead."
msgstr "Le motif contient un caractère de contrôle, comme une tabulation ou un saut de ligne. Utilisez \\t ou \\n à la place."

#: includes/class-typost-ps-grep.php:187
#, php-format
msgid "The pattern uses “%s”, which GREP styles do not support. Patterns must work the same in PHP and in the browser."
msgstr "Le motif utilise « %s », que les styles GREP ne prennent pas en charge. Les motifs doivent fonctionner de la même façon en PHP et dans le navigateur."

#: includes/class-typost-ps-grep.php:193
#, php-format
msgid "The pattern is not valid: %s"
msgstr "Le motif n’est pas valide : %s"

#: includes/class-typost-ps-grep.php:229
msgid "The regular expression engine gave no details."
msgstr "Le moteur d’expressions régulières n’a donné aucun détail."

#: includes/class-typost-ps-grep.php:197
msgid "The pattern takes too long on some text, so it would be turned off. Make it simpler, for example without a repeated group inside a repeated group."
msgstr "Le motif prend trop de temps sur certains textes : il serait désactivé. Simplifiez-le, par exemple sans groupe répété à l’intérieur d’un groupe répété."

#: includes/class-typost-ps-grep.php:468
msgid "(after a lookahead or lookbehind)"
msgstr "(après une assertion avant ou arrière)"

#: includes/class-typost-ps-grep.php:617
msgid "GREP styles must be a list of rules."
msgstr "Les styles GREP doivent être une liste de règles."

#: includes/class-typost-ps-grep.php:622
#, php-format
msgid "A style can have %d GREP rules at most."
msgstr "Un style peut avoir au maximum %d règles GREP."

#: includes/class-typost-ps-grep.php:644
msgid "A GREP rule is not valid."
msgstr "Une règle GREP n’est pas valide."

#: includes/class-typost-ps-grep.php:648
#: assets/js/admin.js:1278
msgid "Choose a pattern for each GREP rule."
msgstr "Choisissez un motif pour chaque règle GREP."

#: includes/class-typost-ps-grep.php:653
#: assets/js/admin.js:1296
msgid "Choose a style for each GREP rule."
msgstr "Choisissez un style pour chaque règle GREP."

#: includes/class-typost-ps-grep.php:656
msgid "A GREP rule cannot apply the style it belongs to. Choose another style."
msgstr "Une règle GREP ne peut pas appliquer le style auquel elle appartient. Choisissez un autre style."

#: includes/class-typost-ps-grep.php:666
msgid "Only administrators can add or change a custom GREP pattern. Choose a built-in pattern."
msgstr "Seuls les administrateurs peuvent ajouter ou modifier un motif GREP personnalisé. Choisissez un motif intégré."

#: paragraph-styles.php:2653
#: includes/class-typost-ps-transfer.php:448
#, php-format
msgid "Custom (%s)"
msgstr "Personnalisé (%s)"

#: paragraph-styles.php:2458
#: includes/class-typost-ps-transfer.php:460
#, php-format
msgid "%1$s → %2$s"
msgstr "%1$s → %2$s"

#: paragraph-styles.php:2461
msgid "GREP styles:"
msgstr "Styles GREP :"

#: includes/admin-tab.php:331
msgid "GREP styles"
msgstr "Styles GREP"

#: includes/admin-tab.php:333
msgid "Apply another style to the text that matches a pattern, wherever this style is used on a whole block. The saved text does not change. Where two rules match the same text, the rule higher in the list wins. Text in fit to width blocks and in code is not matched."
msgstr "Appliquez un autre style au texte qui correspond à un motif, partout où ce style est utilisé sur un bloc entier. Le texte enregistré ne change pas. Quand deux règles correspondent au même texte, la règle la plus haute dans la liste l’emporte. Le texte des blocs ajustés à la largeur et le code ne sont pas pris en compte."

#: includes/admin-tab.php:336
msgid "No GREP rules."
msgstr "Aucune règle GREP."

#: includes/admin-tab.php:338
msgid "Add GREP rule"
msgstr "Ajouter une règle GREP"

#: includes/class-typost-ps-transfer.php:168
#, php-format
msgid "“%1$s” was added because a GREP rule of “%2$s” applies it."
msgstr "« %1$s » a été ajouté, car une règle GREP de « %2$s » l’applique."

#: includes/class-typost-ps-transfer.php:340
#, php-format
msgid "“%1$s”, GREP rule %2$d: %3$s Nothing was saved."
msgstr "« %1$s », règle GREP %2$d : %3$s Rien n’a été enregistré."

#: includes/class-typost-ps-transfer.php:451
#, php-format
msgid "“%1$s” has a custom GREP pattern, which runs on every page that uses the style: %2$s (applies “%3$s”)."
msgstr "« %1$s » a un motif GREP personnalisé, exécuté sur chaque page qui utilise le style : %2$s (applique « %3$s »)."

#: includes/class-typost-ps-transfer.php:489
msgid "GREP styles need WordPress 6.9 or later. They are imported, but have no effect on this site until WordPress is updated."
msgstr "Les styles GREP nécessitent WordPress 6.9 ou une version ultérieure. Ils sont importés, mais sans effet sur ce site tant que WordPress n’est pas mis à jour."

#: includes/class-typost-ps-transfer.php:770
#, php-format
msgid "“%1$s”, GREP rule %2$d: this site does not know the pattern “%3$s”, so the rule is left out."
msgstr "« %1$s », règle GREP %2$d : ce site ne connaît pas le motif « %3$s », la règle est donc ignorée."

#: includes/class-typost-ps-transfer.php:781
#, php-format
msgid "“%1$s”, GREP rule %2$d: “%3$s” is not imported, so the rule is left out."
msgstr "« %1$s », règle GREP %2$d : « %3$s » n’est pas importé, la règle est donc ignorée."

