msgid "Acronyms (NASA)"
msgstr "Acronymes (NASA)"

#: includes/class-typost-ps-grep.php:122
msgid "Fractions (1/2, not dates)"
msgstr "Fractions (1/2, pas les dates)"

#: includes/class-typost-ps-grep.php:123
msgid "Ordinals (the “st” in 1st)"
msgstr "Ordinaux (le « er » de 1er)"

#: includes/class-typost-ps-grep.php:124
msgid "Numbers"
msgstr "Nombres"

#: includes/class-typost-ps-grep.php:125
