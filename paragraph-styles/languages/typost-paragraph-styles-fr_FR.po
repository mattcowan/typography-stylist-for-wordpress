#: includes/admin-tab.php:261
#, php-format
msgid "Four-letter axis tags in quotes, each followed by a number, separated by commas. Example: %s. Leave empty for none."
msgstr "Balises d'axe de quatre lettres entre guillemets, chacune suivie d'un nombre, séparées par des virgules. Exemple : %s. Laissez vide pour aucun axe."

