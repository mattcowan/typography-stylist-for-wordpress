#, php-format
msgid "%s (after the same style only)"
msgstr "%s (seulement après le même style)"

#: paragraph-styles.php:2273
msgid "Space Before:"
msgstr "Espace avant :"

#: paragraph-styles.php:2274
msgid "Space After:"
msgstr "Espace après :"

