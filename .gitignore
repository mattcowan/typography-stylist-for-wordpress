blocks/*/build/

# PHP dependencies (Composer) — anchored to the plugin root so it does not
# swallow glyphs-panel/assets/js/vendor/ (bundled JS libraries, committed)
/vendor/
composer.phar

# Bundled third-party JS libraries must be committed despite *.min.js above
!glyphs-panel/assets/js/vendor/**

# Testing and cache files
.phpunit.result.cache
phpunit.xml

# Windows/system artifacts
nul

# E2E Testing credentials - NEVER commit
.env
.env.local
.env.*.local
tests/e2e/auth.json

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/
# Demo videos (recorded locally, hosted elsewhere)
docs/media/
