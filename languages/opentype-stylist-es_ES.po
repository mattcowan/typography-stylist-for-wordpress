msgstr "Prueba tus encabezados al tamaño de visualización real"

#: includes/admin-page.php:552
msgid "Not all fonts support all features - experiment!"
msgstr "¡No todas las fuentes admiten todas las características - experimenta!"

#: includes/admin-page.php:557
msgid "Technical Notes"
msgstr "Notas Técnicas"

#: includes/admin-page.php:558
msgid "This plugin applies CSS font-feature-settings to selected text using inline styles. The features are stored as data attributes on span elements within your content."
msgstr "Este plugin aplica CSS font-feature-settings al texto seleccionado usando estilos en línea. Las características se almacenan como atributos de datos en elementos span dentro de tu contenido."

#: includes/admin-page.php:559
msgid "Browser support: All modern browsers support OpenType features. Internet Explorer 10+ has partial support."
msgstr "Compatibilidad con navegadores: Todos los navegadores modernos admiten características OpenType. Internet Explorer 10+ tiene compatibilidad parcial."

