#: includes/admin-page.php:548
msgid "Enable \"Contextual Alternates\" (calt) for natural letter connections"
msgstr "Activa \"Alternativas Contextuales\" (calt) para conexiones naturales de letras"

#: includes/admin-page.php:549
msgid "Use swashes sparingly on first or last letters only"
