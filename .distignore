# .distignore — the single source of truth for what does NOT ship to users.
#
# Everything not excluded here IS distributed: to WordPress.org SVN trunk by
# the release workflow (10up/action-wordpress-plugin-deploy), and into the
# local/beta zip by `npm run package` (scripts/package.js reads this file).
# Gitignore-style syntax. When you add a new dev-only file or folder, add it
# here; new production modules ship automatically without touching anything.

# --- VCS / CI / tooling directories ---
/.git
/.github
/.wordpress-org
/.claude
/.playwright-mcp
/playwright-profile
/playwright-report*
/test-results
/node_modules
/vendor
/build
/coverage
/scripts
/tests
/docs
/private

# --- module-level dev files ---
__tests__
__mocks__
/glyphs-panel/CLAUDE.md
/variable-fonts/CLAUDE.md
/paragraph-styles/CLAUDE.md

# --- root config / dev files ---
/.babelrc
/.distignore
/.env
/.env.example
/.gitignore
/.wp-env.json
/.wp-env.override.json
/.phpunit.result.cache
/composer.json
/composer.lock
/jest.config.js
/jest.setup.js
/package-lock.json
/phpunit.xml
/phpunit.xml.dist
# Every Playwright config (playwright.nvda.config.js shipped in 2.3.0)
/playwright*.config.js
/.gitattributes

# --- docs that live on GitHub, not in the distributed plugin ---
# (readme.txt, changelog.txt and BUILD.txt DO ship: readme.txt is the
# WordPress.org listing, and BUILD.txt satisfies the directory's
# build-instructions / minified-source-mapping requirement. It names the
# public repository for the build configuration, which does not ship (#377).)
/CLAUDE.md
/DOCUMENTATION.md
/HOOKS.md
/README.md
/RELEASING.md
/TESTING.md

# --- misc ---
*.zip
.DS_Store
Thumbs.db
